# Environment Configuration Template
# Copy to .env and modify as needed

# Application Configuration
CONTOUR2_DEBUG=false
CONTOUR2_LOG_LEVEL=INFO
CONTOUR2_CONFIG_FILE=config.json

# Performance Configuration
CONTOUR2_MAX_MEMORY_MB=500
CONTOUR2_TRIANGULATION_TIMEOUT=2.0
CONTOUR2_MAX_TRIANGLES=50000

# Visualization Configuration
CONTOUR2_DEFAULT_COLORMAP=terrain
CONTOUR2_ANIMATION_FPS=30

# Paths Configuration
CONTOUR2_DATA_DIR=data
CONTOUR2_EXPORTS_DIR=data/exports
CONTOUR2_CACHE_DIR=cache
CONTOUR2_LOG_DIR=logs

# Development Configuration
CONTOUR2_DEV_MODE=false
CONTOUR2_PROFILING=false
CONTOUR2_STRICT_VALIDATION=true